# ---------------------------------------------------------------------------
# OutreachOS frontend environment (Vite)
# Copy to .env.local and adjust as needed.
# ---------------------------------------------------------------------------

# Base URL of the Django API. Keep it relative so the Vite dev server proxy
# (see vite.config.ts) forwards calls to Django and the browser stays on a
# single origin.
VITE_API_BASE_URL=/api

# Phase 1 ships realistic placeholder data so the dashboard can be developed
# without a running backend. Set to "false" to read from the Django API instead.
VITE_USE_MOCK_DATA=true

# Optional absolute API origin for decoupled deployments. Leave EMPTY to use
# the relative VITE_API_BASE_URL above (recommended: no CORS, works behind any
# proxy). Example: VITE_API_URL=https://api.example.com/api
VITE_API_URL=

# Dev server port + the Django target used by the /api proxy.
VITE_PORT=5173
VITE_PROXY_TARGET=http://127.0.0.1:8000

APP_NAME=OutreachOS
