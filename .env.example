# ===========================================================================
# OutreachOS — environment template
#
#   cp .env.example .env      (then adjust the secrets)
#
# Used by docker compose and by the Django settings in backend/config/settings.
# Never commit the real .env file.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=OutreachOS
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5182

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.development
# Generate one for anything other than local development:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5182,http://127.0.0.1:5182
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC
DJANGO_LANGUAGE_CODE=en-us

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# docker compose injects POSTGRES_HOST=postgres and PORT=5432 automatically.
# ---------------------------------------------------------------------------
POSTGRES_DB=outreachos
POSTGRES_USER=outreachos
POSTGRES_PASSWORD=outreachos
POSTGRES_HOST=localhost
POSTGRES_PORT=5496
POSTGRES_HOST_PORT=5496
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5

# Optional single-string alternative (overrides the POSTGRES_* values above):
# DATABASE_URL=postgresql://outreachos:outreachos@localhost:5432/outreachos

# ---------------------------------------------------------------------------
# Redis & Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6396/0
REDIS_HOST_PORT=6396
CELERY_BROKER_URL=redis://localhost:6396/1
CELERY_RESULT_BACKEND=redis://localhost:6396/2
CELERY_TASK_DEFAULT_QUEUE=outreachos
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PAGE_SIZE=25
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=http://localhost:5182,http://127.0.0.1:5182

# ---------------------------------------------------------------------------
# OutreachOS domain rules
# ---------------------------------------------------------------------------
# Hard product limit on marketing e-mails per day (Phase 1: display only).
OUTREACH_DAILY_EMAIL_LIMIT=90
OUTREACH_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# SMTP delivery is intentionally NOT implemented in Phase 1 — the console
# backend keeps registration/reset flows working without an external provider.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=OutreachOS <no-reply@outreachos.local>

# ---------------------------------------------------------------------------
# Frontend (consumed by Vite — only VITE_* variables reach the browser)
# ---------------------------------------------------------------------------
# Keep the API path relative: the dev server and nginx both proxy /api.
VITE_API_BASE_URL=/api
# Optional absolute API origin (leave empty to keep requests relative/proxied).
VITE_API_URL=
# true  → dashboard renders the Phase 1 placeholder dataset (no backend needed)
# false → dashboard reads GET /api/v1/analytics/dashboard/ from Django
VITE_USE_MOCK_DATA=true
VITE_PORT=5182
VITE_PROXY_TARGET=http://127.0.0.1:8096

# ---------------------------------------------------------------------------
# Host port mappings (change if a port is already in use)
# ---------------------------------------------------------------------------
BACKEND_HOST_PORT=8096
FRONTEND_HOST_PORT=5182
